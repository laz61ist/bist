# Aidat Yönetim Sistemi — ortam değişkenleri
# Bu dosya örnektir. Gerçek .env repoya GİRMEZ.

# Ortam: production | development | test
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8090
APP_NAME="Aidat Yönetim"
# Oturum çerezi ve imzalı bağlantılar için gizli anahtar (en az 32 karakter).
# Üretmek için: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=
APP_TIMEZONE=Europe/Istanbul

# Veritabanı sürücüsü: sqlite | mysql
DB_DRIVER=sqlite
# sqlite için dosya yolu (kalıcı diske işaret etmeli)
DB_SQLITE_PATH=storage/database/aidat.sqlite
# mysql / mariadb için
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aidat
DB_USER=aidat
DB_PASS=
DB_CHARSET=utf8mb4

# E-posta (bildirimler). MAIL_DRIVER: log | mail | smtp
MAIL_DRIVER=log
MAIL_FROM=aidat@example.com
MAIL_FROM_NAME="Site Yönetimi"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls

# SMS (opsiyonel, genel HTTP webhook). SMS_DRIVER: log | webhook
SMS_DRIVER=log
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Dosya yükleme (bayt). Varsayılan 5 MB.
UPLOAD_MAX_BYTES=5242880
