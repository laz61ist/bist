{
    "name": "laz61ist/aidat",
    "description": "Aidat Yönetim Sistemi - apartman ve site aidat, tahsilat, gelir-gider ve şeffaflık yazılımı (Pure PHP 8.3 MVC)",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "ext-pdo_sqlite": "Varsayılan sıfır kurulum veritabanı",
        "ext-pdo_mysql": "MariaDB/MySQL kullanımı için",
        "ext-zip": "XLSX dışa aktarma için (yoksa CSV kullanılır)",
        "ext-gd": "Logo yeniden boyutlandırma için"
    },
    "autoload": {
        "psr-4": { "Aidat\\": "app/", "Aidat\\Database\\": "database/" }
    },
    "autoload-dev": {
        "psr-4": { "Aidat\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php -S 127.0.0.1:8090 -t public public/index.php",
        "migrate": "php bin/aidat migrate",
        "seed": "php bin/aidat seed"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
