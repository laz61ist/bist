# BIST Kokpit — ortam degiskenleri
# Bu dosya ornektir. Gercek .env repoya GIRMEZ (anayasa madde IX).

# Calisma ortami: production | development | test
# Belirtilmezse production varsayilir (guvenli varsayilan).
BIST_ENV=production

# Sqlite veritabani yolu.
# ONEMLI: Kalici bir diske (volume) isaret etmeli, yoksa her yeniden
# baslatmada kullanicinin kaydettigi kriter setleri kaybolur (#7).
BIST_DB_PATH=/data/bist.sqlite

# Azami istek govdesi (bayt). Varsayilan 65536 (64 KB).
# post_max_size application/json govdelerine uygulanmadigi icin
# sinir uygulama katmaninda zorlanir (#13).
BIST_AZAMI_GOVDE_BAYT=65536

# Yazma ucu paylasimli sirri.
# BOS BIRAKILIRSA /kriter uclari TAMAMEN KAPALI kalir ve pano salt
# okunur yayinlanir. Bu kasitli bir guvenli varsayilandir (#10).
# En az 20 karakter; kisa sir yapilandirilmamis sayilir.
# Uretmek icin:  openssl rand -base64 32
BIST_YAZMA_TOKEN=
